{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "isolatedModules": true,
    "resolveJsonModule": true,

    "types": ["node"]
  },
  "include": ["config/**/*", "webpack.config.ts"],
}
